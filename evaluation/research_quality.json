{
  "version": "research-quality-v1",
  "description": "Synthetic fixture corpus with fictional operating rules. Evaluates the production document-only workflow without a model or web calls. Development and reserved validation questions were authored together; this is not an independent or blind benchmark.",
  "documents": [
    {
      "id": "idempotency",
      "title": "Idempotent operations",
      "text": "An idempotent operation has the same effect when repeated as when performed once. The parcel API uses a request token to recognize duplicate submissions and avoid creating a second shipment."
    },
    {
      "id": "backpressure",
      "title": "Backpressure",
      "text": "Backpressure slows a producer when a consumer cannot keep up. The queue uses backpressure because unchecked arrivals would exhaust memory. Producers pause until the queue has room again."
    },
    {
      "id": "breaker",
      "title": "Circuit breaker",
      "text": "A circuit breaker stops requests to a failing dependency after repeated errors. After a cooldown, a trial request checks whether the dependency has recovered. This prevents repeated failures from overwhelming the caller."
    },
    {
      "id": "bluegreen",
      "title": "Blue-green releases",
      "text": "A blue-green release keeps two environments: one serves live traffic while the other receives the new version. Traffic switches after health checks pass. Rollback switches traffic back to the previous environment."
    },
    {
      "id": "parcel",
      "title": "Lark parcel collection",
      "text": "Lark depot holds parcels for three days. A recipient must bring photo identification and the collection code. Uncollected parcels return to the sender after the holding period. The depot closes at 18:00 on weekdays."
    },
    {
      "id": "csv",
      "title": "CSV export",
      "text": "CSV export supports up to fifty thousand rows per file. CSV export flattens nested fields into columns. CSV export jobs expire after six hours."
    },
    {
      "id": "json",
      "title": "JSON export",
      "text": "JSON export supports up to ten thousand records per file. JSON export preserves nested objects. JSON export jobs expire after twelve hours."
    },
    {
      "id": "launch",
      "title": "Field launch checklist",
      "text": "# Field launch checklist\nThe field launch steps are:\n- Inspect the enclosure.\n- Charge the battery.\n- Calibrate the sensor.\n- Record the serial number.\n- Obtain supervisor approval.\n\n# Lunch arrangements\n- Order soup.\n- Collect bread."
    },
    {
      "id": "archive",
      "title": "Archive restoration",
      "text": "# Archive restoration\nThe archive restoration steps are:\n1. Verify the checksum.\n2. Unlock the archive.\n3. Restore the files.\n4. Validate the restored copy.\n\nArchive restoration requires the recovery key. Without the recovery key the encrypted archive cannot be opened."
    },
    {
      "id": "room",
      "title": "Studio booking",
      "text": "A studio booking lasts ninety minutes. Members may reserve a studio up to seven days ahead. Cancel a studio booking at least two hours before it starts to release the room to other members."
    },
    {
      "id": "email",
      "title": "Email verification",
      "text": "An email verification link expires after twenty minutes. Requesting a replacement email verification link invalidates the earlier link. The system does not disclose whether an email address belongs to a registered account."
    },
    {
      "id": "device",
      "title": "Device activation",
      "text": "A device activation link expires after forty minutes. Device activation requires the device serial number and an administrator approval code."
    }
  ],
