# InsightPilot Environment Configuration
# Local editing mode. Public Render deployment uses APP_MODE=demo.
APP_MODE=local
# Optional local Gemini key. Public demo mode never calls Gemini.
GEMINI_API_KEY=
PORT=8080
HOST=127.0.0.1
DEBUG=false
# Optional persistent directory for both SQLite databases in local mode.
# DATA_DIR=/var/data
# Optional comma-separated origins if serving the frontend separately.
# CORS_ORIGINS=https://example.com
